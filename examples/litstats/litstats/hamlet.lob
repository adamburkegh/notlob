#Litstats Hamlet

Word and speaker statistics for Shakespeare's Hamlet, drawn from the
Project Gutenberg plaintext edition (EBook #1524).  The file includes
a preamble and postscript; we strip these by locating the sentinel
lines that bound the play text.

    _DATA = Path(__file__).parent.parent / "data"

    def load_play(filename: str) -> str:
        """Strip Gutenberg header and footer; return play text."""
        raw = (_DATA / filename).read_text(encoding="utf-8")
        start = raw.index("*** START OF THE PROJECT GUTENBERG")
        end   = raw.index("*** END OF THE PROJECT GUTENBERG")
        return raw[raw.index("\n", start) + 1 : end]

    HAMLET = load_play("pg1524.txt")

~example
    "HAMLET." in HAMLET
    len(HAMLET) > 100_000

##Word Frequencies

Stripping punctuation and lowercasing gives a flat word list. The
top words in any English text are function words; finding "the" at
rank 1 and "and" at rank 2 confirms we have the right text in the
right language.

    def word_frequencies(text: str) -> Counter:
        words = re.findall(r"[a-z]+", text.lower())
        return Counter(words)

    WORDS = word_frequencies(HAMLET)

~example
    WORDS.most_common(1)[0][0] == "the"
    WORDS.most_common(2)[1][0] == "and"

The total word count is the sum of all frequencies. This holds for
any input — it is a property of word_frequencies itself, not a
fact specific to Hamlet.

~property
    @given(text=st.text(max_size=200))
    def _(text):
        freqs = word_frequencies(text)
        assert sum(freqs.values()) == len(
            re.findall(r"[a-z]+", text.lower())
        )

##Speaking Parts

Each speech is introduced by the speaker's name in ALL CAPS on its
own line, followed by a period. We count turns — each appearance of
a speaker label is one turn, regardless of how many lines follow.

Hamlet has roughly three times as many turns as the next character.
That dominance is not incidental; it is what the play is built
around.

    def parse_speakers(text: str) -> Counter:
        turns: Counter = Counter()
        for line in text.splitlines():
            m = re.match(r'^([A-Z][A-Z ]+)\.$', line.strip())
            if m:
                turns[m.group(1)] += 1
        return turns

    SPEAKERS = parse_speakers(HAMLET)
    _TOP = SPEAKERS.most_common(10)

~example
    SPEAKERS.most_common(1)[0][0] == "HAMLET"
    SPEAKERS["HAMLET"] > SPEAKERS["KING"] * 2

Summary output:

    print(f"{'=' * 44}")
    print(f"  Hamlet — text statistics")
    print(f"{'=' * 44}")
    print(f"  Words  : {sum(WORDS.values()):>8,}  total")
    print(f"           {len(WORDS):>8,}  unique")
    print()
    print(f"  Top 10 words:")
    for _w, _n in WORDS.most_common(10):
        print(f"    {_w:<16} {_n:>5,}")
    print()
    print(f"  Top 10 speakers (turns):")
    for _s, _n in _TOP:
        print(f"    {_s:<20} {_n:>4,}")
    print(f"{'=' * 44}")

---

#Tests

##text loading
    len(HAMLET) > 100_000
    HAMLET.startswith("\n") or "THE TRAGEDY" in HAMLET[:500]

##word frequencies
    WORDS["the"] > 500
    WORDS["the"] > WORDS["hamlet"]
    WORDS.most_common(1)[0][0] == "the"
    sum(WORDS.values()) > 20_000

##speakers
    SPEAKERS["HAMLET"] > 300
    SPEAKERS["HAMLET"] > SPEAKERS["KING"]
    SPEAKERS.most_common(1)[0][0] == "HAMLET"

#References
    from pathlib import Path
    from collections import Counter
    import re
