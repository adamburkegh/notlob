// notlob.lark
// Grammar for .lob literate source files.
//
// The format is line-oriented: each source line is one semantic unit.
// Every structural line-type (MOD_HEAD, SUBHEAD, SIGIL, INDENT, BLANK,
// BULLET, SEPARATOR, and the reserved post-text heads) is a native Lark
// terminal, matched directly against the raw source text — there is no
// separate Python line classifier feeding Lark a pre-typed token stream.
//
// Disambiguation mechanism
// ------------------------
// Column-zero structural lines (e.g. `##Title`) and the same text
// occurring inline mid-prose (e.g. `See ##Title.`) are lexically
// identical spans. Lark's contextual lexer narrows candidate terminals
// by parser state, but at a body-item boundary, both a fresh structural
// line AND continuing prose are valid continuations — so more than one
// terminal can match the same text from the same state. The tie-break is
// explicit terminal priority (the `.N` suffix): every structural terminal
// outranks the generic REF/PROSE_TEXT terminals it can collide with.
//
// The closed sigil vocabulary is the one place priority isn't the whole
// story: SIGIL and TEST_SIGIL together enumerate every known word as an
// exact literal, and `~` is excluded from PROSE_TEXT only at true
// line-start (a lookbehind, not "first char of any prose span" — prose
// spans can also start mid-line, right after an inline ref). Genuinely
// unknown sigils therefore fail to lex at all, rather than silently
// becoming prose. `~test` is deliberately its own terminal (TEST_SIGIL),
// separate from SIGIL, so the grammar itself — not a semantic check —
// enforces that it's only legal inside a #Tests named_test, never in
// the module body.

start: module

module: MOD_HEAD body post_text?

// ── Essay body ──────────────────────────────────────────────

body: body_item*

body_item: subheading
         | code_block
         | claim
         | prose_block
         | bullet_block
         | BLANK

// Subheadings are flat within a module — ## nesting is not permitted.
// _sub_item mirrors body_item without the subheading alternative,
// enforcing the flat constraint directly in the grammar.
subheading: SUBHEAD _sub_item*
_sub_item: code_block | claim | prose_block | bullet_block | BLANK

// An indented block begins with an INDENT line and continues while
// each subsequent line is INDENT or BLANK.
code_block: INDENT _body_line*

// A claim sigil followed by its indented body (at least one line).
claim: SIGIL _body_line+

// A prose block is one or more prose lines.  Each prose_line is a
// sequence of plain-text fragments and inline refs, terminated by a
// PROSE_NL sentinel.  Blank lines between paragraphs produce separate
// prose_block nodes because BLANK is a body_item, not part of a
// prose_line.
prose_block: prose_line+
prose_line:  (LINE_START_TEXT | PROSE_TEXT | REF)+ PROSE_NL

// A bullet block is one or more consecutive BULLET lines.  Bullets
// must be flush-left (* item); indented bullets remain code (INDENT).
bullet_block: BULLET+

_body_line: INDENT | BLANK

// ── Post-text ───────────────────────────────────────────────

post_text: SEPARATOR (BLANK | post_section)*

post_section: tests_section
            | binding_section
            | references_section
            | appendix_section

// #Tests groups accept prose commentary alongside assertions, the
// same as the module body -- a literate-programming appendix that
// can't carry any prose at all would be a strange exception to the
// rest of the format. A useful side effect: because prose_block is a
// genuinely different terminal from INDENT/BLANK, inserting one
// between two adjacent indented constructs (e.g. a bare assertion
// right after a ~test block) cleanly separates them -- named_test's
// own body is a greedy repetition (_body_line+, like claim/code_block
// elsewhere in this grammar), so without something in between, a
// trailing bare INDENT/BLANK line would merge into the preceding
// named_test rather than standing on its own.
tests_section:      TESTS_HEAD      (BLANK | test_item | prose_block)*
test_item:          test_group | INDENT
test_group:         SUBHEAD (INDENT | BLANK | prose_block | named_test)*

// A named assertion within a #Tests group (`~test <name>`, followed
// by one or more indented assertion lines). TEST_SIGIL is a terminal
// distinct from SIGIL specifically so ~test is grammar-enforced as
// illegal in the module body -- it only exists inside #Tests.
named_test:         TEST_SIGIL _body_line+

binding_section:    BINDING_HEAD    (LANGUAGE_DECL | EXTERNAL_DECL | ON_BUILD_DECL | KEEP_SRC_DECL | BLANK)*
references_section: REFERENCES_HEAD (INDENT | BLANK)*
appendix_section:   APPENDIX_HEAD   body_item*

// ── Terminal definitions ────────────────────────────────────
//
// Every terminal consumes through its own trailing newline (so the
// lexer's cursor is always at a true physical line-start when trying
// the next token) EXCEPT the prose sub-tokens (LINE_START_TEXT,
// PROSE_TEXT, REF), which build up a multi-span prose_line ending in a
// separate PROSE_NL sentinel.
//
// Priorities: structural line-types are priority 20 (post-text
// reserved heads and SEPARATOR — must outrank both the generic MOD_HEAD
// and REF/PROSE_TEXT) or priority 10 (MOD_HEAD, SUBHEAD, SIGIL — must
// outrank REF/PROSE_TEXT but never compete with the post-text heads,
// since those are distinguished by their own literal text). INDENT and
// BULLET are priority 8 (must outrank PROSE_TEXT but nothing else
// contends for leading whitespace or `*`). REF is priority 5. PROSE_TEXT
// and LINE_START_TEXT are priority 1 — the generic fallback.
//
// LINE_CHAR / REST_OF_LINE are helper terminals, not structural tokens
// in their own right — they're referenced from other terminal
// definitions below (Lark inlines them at compile time) purely to avoid
// repeating "any character but newline, zero or more times" six times.
// Because neither is ever referenced from a grammar *rule*, the lexer
// never treats them as independently matchable tokens, so this carries
// no priority or ambiguity implications of its own.

LINE_CHAR: /[^\n]/
REST_OF_LINE: LINE_CHAR*

MOD_HEAD.10: "#" /[^#\n]/ REST_OF_LINE "\n"
SUBHEAD.10:  "##" REST_OF_LINE "\n"

// Closed vocabulary for body-level claims. `~test` is deliberately not
// here — it's TEST_SIGIL below, a separate terminal only reachable from
// named_test (inside #Tests), so a `~test` line in the module body
// fails to lex, the same as any other unrecognised sigil would. A
// `~word` outside this list simply fails to lex, since
// PROSE_TEXT/LINE_START_TEXT exclude `~` at line-start; there is no
// silent fallback.
SIGIL.10: "~example\n" | "~run\n" | "~property\n" | "~property " REST_OF_LINE "\n"

// ~test <name>: requires a name (unlike ~property, where the name is
// optional) -- an unnamed ~test wouldn't do anything a bare assertion
// line doesn't already do, so there's no bare `~test\n` form. LINE_CHAR+
// (one or more), not REST_OF_LINE (zero or more), so "~test \n" with
// no actual name fails to lex rather than silently matching.
TEST_SIGIL.10: "~test " LINE_CHAR+ "\n"

// Typed declarations inside #Binding.  Priority 9 sits between INDENT.8
// and the body-level structural terminals at 10 — high enough to win over
// INDENT inside a binding_section context, low enough not to interfere
// elsewhere (INDENT is still the right match for code-block lines in the
// essay body and post-text sections other than #Binding).
LANGUAGE_DECL.9:  /[ \t]+/ "~language "         LINE_CHAR+ "\n"
EXTERNAL_DECL.9:  /[ \t]+/ "~external "         LINE_CHAR+ "\n"
ON_BUILD_DECL.9:  /[ \t]+/ "~on-build "         LINE_CHAR+ "\n"
KEEP_SRC_DECL.9:  /[ \t]+/ "~keep-generated-src" REST_OF_LINE "\n"

SEPARATOR.20:        "---\n"
TESTS_HEAD.20:       "#Tests\n"
BINDING_HEAD.20:     "#Binding\n"
REFERENCES_HEAD.20:  "#References\n"
APPENDIX_HEAD.20:    "#Appendix:" REST_OF_LINE "\n"

INDENT.8: /[ \t]/ REST_OF_LINE "\n"
BLANK.8:  "\n"
BULLET.8: "*" (/[ \t]/ REST_OF_LINE)? "\n"

// Inline cross-reference: #Label or ##Label mid-prose. Lookbehind
// prevents matching # inside URLs or identifiers.
REF.5: /(?<![\w\/])##?[A-Z][A-Za-z0-9_]*(?:[ ][A-Z][A-Za-z0-9_]*)*/

// First prose span of a genuine physical line (lookbehind anchors to
// true line-start, not "first char of any prose token"). Excludes `~`
// only when followed by a lowercase letter (a genuine sigil candidate —
// closed-vocabulary enforcement; `~Word` or `~5` is not sigil-shaped and
// stays prose) and `#` only when it's actually ref/head-shaped — a bare
// `#5` or `#hashtag` stays prose too.
LINE_START_TEXT.1: /(?<=\n)(?:[^#~\n]|#(?!#?[A-Z])|~(?![a-z]))(?:[^#\n]|#(?!#?[A-Z]))*/

// Any other prose span (mid-line — e.g. immediately after an inline
// REF ends). `~` is fully ordinary here; `#` still yields only when
// ref-shaped, so REF gets a chance to match.
PROSE_TEXT.1: /(?<!\n)(?:[^#\n]|#(?!#?[A-Z]))+/

PROSE_NL: "\n"
