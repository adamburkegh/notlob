// Grammar for .lob files. Every character of the source is in exactly
// one token of the tree.

start: module

module: MOD_HEAD body post_text?

// ── Body ────────────────────────────────────────────────────

body: body_item*
body_item: subheading | code_block | claim | prose_block | bullet_block
         | BLANK

// Flat: a subheading holds no subheading.
subheading: SUBHEAD _sub_item*
_sub_item: code_block | claim | prose_block | bullet_block | BLANK

code_block: INDENTED_LINE _body_line*
claim: SIGIL _body_line+
_body_line: INDENTED_LINE | BLANK

prose_block: prose_line+
prose_line: (LINE_START_TEXT | PROSE_TEXT | REF)+ BLANK
bullet_block: BULLET+

// ── Post-text ───────────────────────────────────────────────

post_text: SEPARATOR (BLANK | post_section)*
post_section: tests_section | binding_section | references_section
            | appendix_section

tests_section: TESTS_HEAD (BLANK | test_item | prose_block)*
test_item: test_group | INDENTED_LINE
test_group: SUBHEAD (INDENTED_LINE | BLANK | prose_block | named_test)*
// `~test` is reachable only here, so in the body it fails to lex.
named_test: TEST_SIGIL _body_line+

binding_section: BINDING_HEAD (INDENT bind_detail_decl | BLANK)*
bind_detail_decl: LANGUAGE_DECL | EXTERNAL_DECL | ON_BUILD_DECL
                | KEEP_SRC_DECL
references_section: REFERENCES_HEAD (LISTING_LINE | INDENTED_LINE
                                     | BLANK)*
appendix_section: APPENDIX_HEAD body_item*

// ── Terminals ───────────────────────────────────────────────
//
// Priority settles a line that two terminals match: 20 for the post-text
// heads and SEPARATOR, 10 for the headings and SIGIL, 8-9 for leading
// whitespace and `*`, 5 for REF, 1 for prose.

LINE_CHAR: /[^\n]/
REST_OF_LINE: LINE_CHAR* "\n"

MOD_HEAD.10: "#" /[^#\n]/ REST_OF_LINE
SUBHEAD.10: "##" REST_OF_LINE
SIGIL.10: "~example\n" | "~run\n" | "~run on-load\n"
        | "~run on-invocation\n" | "~property\n" | "~property " REST_OF_LINE
TEST_SIGIL.10: "~test " LINE_CHAR REST_OF_LINE

LANGUAGE_DECL: "~language " LINE_CHAR REST_OF_LINE
EXTERNAL_DECL: "~external " LINE_CHAR REST_OF_LINE
ON_BUILD_DECL: "~on-build " LINE_CHAR REST_OF_LINE
KEEP_SRC_DECL: "~keep-generated-src" REST_OF_LINE

SEPARATOR.20: "---\n"
TESTS_HEAD.20: "#Tests\n"
BINDING_HEAD.20: "#Binding\n"
REFERENCES_HEAD.20: "#References\n"
APPENDIX_HEAD.20: "#Appendix" REST_OF_LINE

INDENT: /[ \t]+/
INDENTED_LINE.8: INDENT REST_OF_LINE
// An indented `#Title`, only in #References: a listing, not a comment.
LISTING_LINE.9: INDENT "#" /[^#\s]/ REST_OF_LINE
BLANK.8: "\n"
BULLET.8: "*" ("\n" | /[ \t]/ REST_OF_LINE)

// A reference word starts with an uppercase, titlecase or uncased letter
// (Lu, Lt, Lo), so `#pricing` and `#café` stay prose. Needs regex=True.
REF.5: /(?<![\w\/])##?[\p{Lu}\p{Lt}\p{Lo}][\p{L}\p{Nd}_]*(?:[ ][\p{Lu}\p{Lt}\p{Lo}][\p{L}\p{Nd}_]*)*/

// Prose at the start of a line: not a sigil-shaped `~` or a ref-shaped
// `#`. Then prose after a REF on the same line.
LINE_START_TEXT.1: /(?<=\n)(?:[^#~\n]|#(?!#?[\p{Lu}\p{Lt}\p{Lo}])|~(?![a-z]))(?:[^#\n]|#(?!#?[\p{Lu}\p{Lt}\p{Lo}]))*/
PROSE_TEXT.1: /(?<!\n)(?:[^#\n]|#(?!#?[\p{Lu}\p{Lt}\p{Lo}]))+/
