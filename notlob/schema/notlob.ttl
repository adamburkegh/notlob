# The vocabulary used by `notlob graph --format turtle`.
#
# NAMESPACE: `urn:notlob:ns:` is an INFORMAL namespace. `notlob` is not a
# registered URN namespace identifier (RFC 8141 expects IANA
# registration); it is used here as a self-contained, location-independent
# name so that no URL has to be kept alive. It cannot be fetched from its
# own name, which is why this file ships with notlob. It may be replaced
# by a registered or `tag:` namespace in a future version, which would be
# called out in the CHANGELOG.
#
# A test keeps this file in step with the emitter, at every level: the
# classes are the node kinds (UpperCamelCase), the object properties are
# the edge kinds and the reference a paragraph holds, and the datatype
# properties are the literals a node carries. See tests/test_turtle.py.
#
# The rule: a value that is a node of the graph is an edge, an object
# property whose range is notlob:Node; any other value is a field of its
# node, and a field with several values is a list. What is written is a
# field, and what it resolves to is an edge. A paragraph's reference
# (notlob:ref) is an object property to a blank node, a structured value
# that is not a node, so a field. See tests/test_field_or_edge.py.

@prefix notlob: <urn:notlob:ns:> .
@prefix rdf:    <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs:   <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl:    <http://www.w3.org/2002/07/owl#> .
@prefix xsd:    <http://www.w3.org/2001/XMLSchema#> .

<urn:notlob:ns:> a owl:Ontology ;
    rdfs:label "notlob name-graph vocabulary" ;
    rdfs:comment """The terms notlob uses to export a project's name-graph as RDF: a node per element of a project's .lob files (module, section, paragraph, symbol, claim, ...) and an edge per relationship between them, at one of three levels of detail. Informal namespace; see the note at the top of this file.""" .

# ── Nodes ────────────────────────────────────────────────────

notlob:Node a owl:Class ;
    rdfs:label "Node" ;
    rdfs:comment "A named thing in a notlob project. Every node has exactly one address, and is an instance of exactly one of the kind classes below. Only a module has an rdfs:label, its title: any other node's name follows from its address." .

notlob:Module a owl:Class ;
    rdfs:subClassOf notlob:Node ;
    rdfs:label "Module" ;
    rdfs:comment "A .lob file; its address is its path relative to the project root, without the extension, and its rdfs:label is its title." .

notlob:Subheading a owl:Class ;
    rdfs:subClassOf notlob:Node ;
    rdfs:label "Subheading" ;
    rdfs:comment "A ##Subheading within a module." .

notlob:Symbol a owl:Class ;
    rdfs:subClassOf notlob:Node ;
    rdfs:label "Symbol" ;
    rdfs:comment "A code-level defined name (function, class, constant) in a module or subheading." .

notlob:Property a owl:Class ;
    rdfs:subClassOf notlob:Node ;
    rdfs:label "Property" ;
    rdfs:comment "A ~property claim, named or not." .

notlob:Example a owl:Class ;
    rdfs:subClassOf notlob:Node ;
    rdfs:label "Example" ;
    rdfs:comment "An ~example claim block." .

notlob:Run a owl:Class ;
    rdfs:subClassOf notlob:Node ;
    rdfs:label "Run" ;
    rdfs:comment "A ~run entry-point block." .

notlob:Test a owl:Class ;
    rdfs:subClassOf notlob:Node ;
    rdfs:label "Test" ;
    rdfs:comment "A test in #Tests: a ~test <name> block, or a run of bare assertions." .

notlob:External a owl:Class ;
    rdfs:subClassOf notlob:Node ;
    rdfs:label "External" ;
    rdfs:comment "A file declared with ~external in binding.lob: part of the project but outside the .lob world." .

notlob:Prose a owl:Class ;
    rdfs:subClassOf notlob:Node ;
    rdfs:label "Prose" ;
    rdfs:comment "A paragraph of prose, written in a module, a subheading, an #Appendix, #Tests or a test group." .

notlob:Code a owl:Class ;
    rdfs:subClassOf notlob:Node ;
    rdfs:label "Code" ;
    rdfs:comment "An indented code block, written in a module, a subheading or an #Appendix." .

notlob:Bullets a owl:Class ;
    rdfs:subClassOf notlob:Node ;
    rdfs:label "Bullets" ;
    rdfs:comment "A bullet list, written in a module, a subheading or an #Appendix." .

notlob:Appendix a owl:Class ;
    rdfs:subClassOf notlob:Node ;
    rdfs:label "Appendix" ;
    rdfs:comment "An #Appendix section: one of the sections after the --- separator, with an optional title and a body of its own." .

notlob:Tests a owl:Class ;
    rdfs:subClassOf notlob:Node ;
    rdfs:label "Tests" ;
    rdfs:comment "The #Tests section of a module, holding its test groups and bare assertions." .

notlob:PostText a owl:Class ;
    rdfs:subClassOf notlob:Node ;
    rdfs:label "Post-text" ;
    rdfs:comment "Everything after a module's --- separator: its #Tests section and its appendices. Part of the tree but not of an address. Not written at the outline level, where what it contains belongs to the node above it." .

notlob:TestGroup a owl:Class ;
    rdfs:subClassOf notlob:Node ;
    rdfs:label "Test group" ;
    rdfs:comment "A ##group in #Tests, which holds tests." .

notlob:References a owl:Class ;
    rdfs:subClassOf notlob:Node ;
    rdfs:label "References" ;
    rdfs:comment "The #References section of a module, holding the modules it lists and the import statements of the bound language." .

notlob:Binding a owl:Class ;
    rdfs:subClassOf notlob:Node ;
    rdfs:label "Binding" ;
    rdfs:comment "The #Binding section of binding.lob, holding its declarations." .

notlob:Listing a owl:Class ;
    rdfs:subClassOf notlob:Node ;
    rdfs:label "Listing" ;
    rdfs:comment "A module listed in #References (#Title). An imports edge starts at it." .

notlob:Import a owl:Class ;
    rdfs:subClassOf notlob:Node ;
    rdfs:label "Import" ;
    rdfs:comment "One import statement of the bound language in #References; a statement over several lines is one node." .

notlob:Declaration a owl:Class ;
    rdfs:subClassOf notlob:Node ;
    rdfs:label "Declaration" ;
    rdfs:comment "A declaration in #Binding: ~language, ~external, ~on-build or ~keep-generated-src. A uses_external edge starts at the one that names a file." .

# ── What a node carries ──────────────────────────────────────
# A module's title is its `rdfs:label`; no other node has one.

notlob:address a owl:DatatypeProperty ;
    rdfs:label "address" ;
    rdfs:comment "The node's exact machine identifier, e.g. roman/numerals#to_roman. The node's IRI is derived from it with some characters percent-encoded; this literal is the unencoded value." ;
    rdfs:domain notlob:Node ;
    rdfs:range xsd:string .

notlob:file a owl:DatatypeProperty ;
    rdfs:label "file" ;
    rdfs:comment "The .lob file a module is, relative to the project root, with '/' separators. Written on a module only (and not on one built on its own): any other node's module is the part of its address before the first '#'." ;
    rdfs:domain notlob:Node ;
    rdfs:range xsd:string .

notlob:startLine a owl:DatatypeProperty ;
    rdfs:label "startLine" ;
    rdfs:comment "The 1-based line of its file where a node begins, or where a reference is written. Absent when unknown." ;
    rdfs:range xsd:integer .

notlob:endLine a owl:DatatypeProperty ;
    rdfs:label "endLine" ;
    rdfs:comment "The 1-based last non-blank line of its file that the node occupies. Absent when unknown." ;
    rdfs:domain notlob:Node ;
    rdfs:range xsd:integer .

notlob:named a owl:DatatypeProperty ;
    rdfs:label "named" ;
    rdfs:comment "True where the document gives the node a name (a heading, a ##group, a ~property or a ~test); its address ends in the name. Absent for an anonymous node." ;
    rdfs:domain notlob:Node ;
    rdfs:range xsd:boolean .

notlob:mode a owl:DatatypeProperty ;
    rdfs:label "mode" ;
    rdfs:comment "When a Run runs: on-load or on-invocation (what a bare ~run means)." ;
    rdfs:domain notlob:Run ;
    rdfs:range xsd:string .

notlob:declares a owl:DatatypeProperty ;
    rdfs:label "declares" ;
    rdfs:comment "What a Declaration declares: language, external, on-build or keep-generated-src." ;
    rdfs:domain notlob:Declaration ;
    rdfs:range xsd:string .

notlob:value a owl:DatatypeProperty ;
    rdfs:label "value" ;
    rdfs:comment "The value a Declaration gives what it declares (the language, or the file), when it has one." ;
    rdfs:domain notlob:Declaration ;
    rdfs:range xsd:string .

notlob:size a owl:DatatypeProperty ;
    rdfs:label "size" ;
    rdfs:comment "The characters of text held at or under the node, each leaf's text counted once; a symbol holds none of its own, so it adds nothing to its section and its own size is that of its lines. Written from the index level." ;
    rdfs:domain notlob:Node ;
    rdfs:range xsd:integer .

notlob:text a owl:DatatypeProperty ;
    rdfs:label "text" ;
    rdfs:comment "The text a node holds: a paragraph with its references written with their sigils, a dedented code block, a bullet list's items one to a line, a claim's dedented lines, a run of assertions or a named test as written. Written at the full level, once, and never for a symbol (its lines are in its code block)." ;
    rdfs:domain notlob:Node ;
    rdfs:range xsd:string .

notlob:ref a owl:ObjectProperty ;
    rdfs:label "ref" ;
    rdfs:comment "A #Label or ##Label written in a paragraph: a blank node with the label (rdfs:label), whether it is a ##Label for a subheading (notlob:sub) and the line it is written on (notlob:startLine). Written from the index level." ;
    rdfs:domain notlob:Prose .

notlob:sub a owl:DatatypeProperty ;
    rdfs:label "sub" ;
    rdfs:comment "True for a ##Label reference, which names a subheading of the module only; false for #Label." ;
    rdfs:range xsd:boolean .

# ── Relationships between nodes ──────────────────────────────

notlob:contains a owl:ObjectProperty ;
    rdfs:label "contains" ;
    rdfs:comment "A node contains what is written in it: a module its sections and paragraphs, a code block its symbols. Each node but a module and an external file is contained by one node." ;
    rdfs:domain notlob:Node ;
    rdfs:range notlob:Node .

notlob:imports a owl:ObjectProperty ;
    rdfs:label "imports" ;
    rdfs:comment "A module imports another module by a lob-ref in #References." ;
    rdfs:domain notlob:Node ;
    rdfs:range notlob:Node .

notlob:uses_external a owl:ObjectProperty ;
    rdfs:label "uses_external" ;
    rdfs:comment "The binding module uses an external file declared with ~external." ;
    rdfs:domain notlob:Node ;
    rdfs:range notlob:Node .

notlob:uses a owl:ObjectProperty ;
    rdfs:label "uses" ;
    rdfs:comment "Code refers to a symbol (a statically visible reference): a symbol, a claim or a test to the symbol it names." ;
    rdfs:domain notlob:Node ;
    rdfs:range notlob:Node .

notlob:cites a owl:ObjectProperty ;
    rdfs:label "cites" ;
    rdfs:comment "A paragraph cites another node with a #Label cross-reference; at the outline level, the section that holds the paragraph does." ;
    rdfs:domain notlob:Node ;
    rdfs:range notlob:Node .
