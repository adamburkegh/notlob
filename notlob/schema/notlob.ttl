# The vocabulary used by `notlob graph --format turtle`.
#
# NAMESPACE: `urn:notlob:ns:` is an INFORMAL namespace. `notlob` is not a
# registered URN namespace identifier (RFC 8141 expects IANA
# registration); it is used here as a self-contained, location-independent
# name so that no URL has to be kept alive. It cannot be fetched from its
# own name, which is why this file ships with notlob. It may be replaced
# by a registered or `tag:` namespace in a future version, which would be
# called out in the CHANGELOG.
#
# A test keeps this file in step with the emitter: the classes are the
# node kinds, the object properties are the edge kinds, and the datatype
# properties are the literals a node carries. See tests/test_turtle.py.

@prefix notlob: <urn:notlob:ns:> .
@prefix rdf:    <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs:   <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl:    <http://www.w3.org/2002/07/owl#> .
@prefix xsd:    <http://www.w3.org/2001/XMLSchema#> .

<urn:notlob:ns:> a owl:Ontology ;
    rdfs:label "notlob name-graph vocabulary" ;
    rdfs:comment """The terms notlob uses to export a project's name-graph as RDF: a node per named thing (module, subheading, symbol, claim, ...) and an edge per relationship between them. Informal namespace; see the note at the top of this file.""" .

# ── Nodes ────────────────────────────────────────────────────

notlob:Node a owl:Class ;
    rdfs:label "Node" ;
    rdfs:comment "A named thing in a notlob project. Every node has exactly one address and one label, and is an instance of exactly one of the kind classes below." .

notlob:Module a owl:Class ;
    rdfs:subClassOf notlob:Node ;
    rdfs:label "Module" ;
    rdfs:comment "A .lob file; its address is its path relative to the project root, without the extension." .

notlob:Subheading a owl:Class ;
    rdfs:subClassOf notlob:Node ;
    rdfs:label "Subheading" ;
    rdfs:comment "A ##Subheading within a module." .

notlob:Appendix a owl:Class ;
    rdfs:subClassOf notlob:Node ;
    rdfs:label "Appendix" ;
    rdfs:comment "An #Appendix section: a body of its own (prose, code, subheadings and claims), contained by its module and addressed by position, e.g. roman/numerals#appendix#1. Its symbols and claims are defined by it, and its claims are numbered within it." .

notlob:Symbol a owl:Class ;
    rdfs:subClassOf notlob:Node ;
    rdfs:label "Symbol" ;
    rdfs:comment "A code-level defined name (function, class, constant) in a module or subheading." .

notlob:Property a owl:Class ;
    rdfs:subClassOf notlob:Node ;
    rdfs:label "Property" ;
    rdfs:comment "A named ~property claim." .

notlob:Example a owl:Class ;
    rdfs:subClassOf notlob:Node ;
    rdfs:label "Example" ;
    rdfs:comment "An ~example claim block." .

notlob:Run a owl:Class ;
    rdfs:subClassOf notlob:Node ;
    rdfs:label "Run" ;
    rdfs:comment "A ~run entry-point block." .

notlob:Test a owl:Class ;
    rdfs:subClassOf notlob:Node ;
    rdfs:label "Test" ;
    rdfs:comment "A #Tests group, bare assertions, or a ~test <name> block." .

notlob:External a owl:Class ;
    rdfs:subClassOf notlob:Node ;
    rdfs:label "External" ;
    rdfs:comment "A file declared with ~external in binding.lob: part of the project but outside the .lob world." .

# ── What a node carries ──────────────────────────────────────
# A node's human-readable name is `rdfs:label`.

notlob:address a owl:DatatypeProperty ;
    rdfs:label "address" ;
    rdfs:comment "The node's exact machine identifier, e.g. roman/numerals#to_roman. The node's IRI is derived from it with some characters percent-encoded; this literal is the unencoded value." ;
    rdfs:domain notlob:Node ;
    rdfs:range xsd:string .

notlob:startLine a owl:DatatypeProperty ;
    rdfs:label "startLine" ;
    rdfs:comment "The 1-based source line where the node begins in its .lob file. Absent when unknown." ;
    rdfs:domain notlob:Node ;
    rdfs:range xsd:integer .

notlob:prose a owl:DatatypeProperty ;
    rdfs:label "prose" ;
    rdfs:comment "The plain text of the node's prose, with inline cross-references written with their #Label sigil. Emitted only when content is requested." ;
    rdfs:domain notlob:Node ;
    rdfs:range xsd:string .

notlob:code a owl:DatatypeProperty ;
    rdfs:label "code" ;
    rdfs:comment "The node's dedented source code. Emitted only when content is requested." ;
    rdfs:domain notlob:Node ;
    rdfs:range xsd:string .

# ── Relationships between nodes ──────────────────────────────

notlob:contains a owl:ObjectProperty ;
    rdfs:label "contains" ;
    rdfs:comment "A module contains a subheading." ;
    rdfs:domain notlob:Node ;
    rdfs:range notlob:Node .

notlob:defines a owl:ObjectProperty ;
    rdfs:label "defines" ;
    rdfs:comment "A module or subheading defines a symbol or claim." ;
    rdfs:domain notlob:Node ;
    rdfs:range notlob:Node .

notlob:imports a owl:ObjectProperty ;
    rdfs:label "imports" ;
    rdfs:comment "A module imports another module by a lob-ref in #References." ;
    rdfs:domain notlob:Node ;
    rdfs:range notlob:Node .

notlob:uses_external a owl:ObjectProperty ;
    rdfs:label "uses_external" ;
    rdfs:comment "The binding module uses an external file declared with ~external." ;
    rdfs:domain notlob:Node ;
    rdfs:range notlob:Node .

notlob:uses a owl:ObjectProperty ;
    rdfs:label "uses" ;
    rdfs:comment "A symbol refers to another symbol (a statically visible reference in its code)." ;
    rdfs:domain notlob:Node ;
    rdfs:range notlob:Node .

notlob:references a owl:ObjectProperty ;
    rdfs:label "references" ;
    rdfs:comment "A module or subheading mentions another node in its prose with a #Label cross-reference." ;
    rdfs:domain notlob:Node ;
    rdfs:range notlob:Node .
